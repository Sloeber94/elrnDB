[[64,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo and remove the sump condensed engine oil return pipe connector.</p><p>2. Unscrew and remove the engine oil level sensor.</p><p>3. Undo bolts (3a) and remove buffeting bulkhead (3b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/939005642.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[64,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit the bulkhead and tighten the bolts fixing it to the oil sump.</p><p>Screw in the engine oil level sensor.</p><p>Fit the sump condensed engine oil return pipe connector.</p>"],[6,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the crankcase oil sump partition (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/194000215.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[6,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the crankcase oil sump partition back in its housing and secure it using the bolts.</p>"],[32,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the crankcase oil sump partition (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/194004524.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[32,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the crankcase oil sump partition back in its housing and secure it using the bolts.</p>"],[16,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the crankcase oil sump partition (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/194004524.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[16,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the crankcase oil sump partition back in its housing and secure it using the bolts.</p>"],[8,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the crankcase oil sump upper partition (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/946000325.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<p>1. Undo the bolts (1a) and remove the crankcase oil sump lower partition (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/946000326.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the crankcase oil sump lower partition back in its housing and secure it using the bolts.</p><p>- Place the crankcase oil sump upper partition back in its housing and secure it using the bolts.</p>"],[1,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the partition (1b).</p><p>2. Remove the gauze filter.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/194005199.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the partition complete with gauze filter back in its housing and secure it using the bolts.</p>"]]