[[127,3,0,"<h3 class=\"step\" data-step=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the door.</p><p>1. Release the retaining buttons using the special tool.</p><div class=\"table\"><table><tr><th><p>Tool</p></th><th><p>Description</p></th><th><p>Function</p></th><th><p>Validity</p></th></tr><tr><td><p>1823015000</p></td><td><p>Knife</p></td><td><p>Retainer removal</p></td><td></td></tr></table></div><aside class=\"note\"><img class=\"icon\" src=\"media/767.jpg\" alt=\"\" loading=\"lazy\"><p>When refitting, replace the retaining buttons.</p></aside><p>2. Keep the gasket.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"media/939000621.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[127,3,0,"<h3 class=\"step\" data-step=\"refitting\"><img class=\"icon\" src=\"media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the seal is not damaged.</p><p>- Place the seal in position and secure it using new retaining buttons.</p>"]]