[[127,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the boot lid.</p><p>1. Release the seal and remove it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/939000671.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[127,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the seal is intact and there are no signs of damage.</p><p>1. Place the seal in position so that the join (1a) is in line with the lock striker (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/939000672.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[127,3,0,"<p>- Check that the contact between the seal and the boot lid is correct.</p>"]]