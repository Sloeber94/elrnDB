[[48,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the coolant pump (1b) complete with gasket.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194004386.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[48,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Refit the water pump, complete with gasket, in its housing and secure it tightening the bolts to the recommended torque.</p><div class=\"table\"><table><tr><th><p>Component</p></th><th><p>Fastening</p></th><th><p>dia</p></th><th><p>Value (daNm)</p></th><th><p>Validity</p></th></tr><tr><td><p>Water pump</p></td><td><p>Bolt</p></td><td><p>M8</p></td><td><p>(cylinder head side) 2.3 -  2.8</p></td><td><p>1.9 JTD 8v</p><p>1.9 JTD 16v</p></td></tr></table></div>"]]